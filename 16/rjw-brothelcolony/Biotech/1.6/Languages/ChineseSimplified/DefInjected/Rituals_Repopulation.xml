<LanguageData>
  <!--EN: An attempt will be made to tamper with the genes of the target or their unborn.-->
  <CB_GeneTampering.description>将尝试篡改目标或其未出生后代的基因。</CB_GeneTampering.description>
  <!--EN: gene tampering-->
  <CB_GeneTampering.label>基因篡改</CB_GeneTampering.label>
  <!--EN: Gene tamperer-->
  <CB_GeneTampering_Behavior.roles.0.label>基因篡改者</CB_GeneTampering_Behavior.roles.0.label>
  <!--EN: Target-->
  <CB_GeneTampering_Behavior.roles.1.label>目标</CB_GeneTampering_Behavior.roles.1.label>
